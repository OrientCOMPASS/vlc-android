<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- the engine renders into this view; it also owns the VR gestures and the
         HUD overlay (tap the picture to toggle the HUD) -->
    <org.videolan.libvlcrs.VrVideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#60000000"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:typeface="monospace" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#A0000000"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/mode"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/eye"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eye_default"
                android:textSize="12sp" />

            <Button
                android:id="@+id/gyro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gyro_off"
                android:textSize="12sp" />

            <Button
                android:id="@+id/recenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recenter"
                android:textSize="12sp" />

            <Button
                android:id="@+id/play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pause"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:minWidth="120dp"
                android:text="00:00 / 00:00"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:typeface="monospace" />

            <SeekBar
                android:id="@+id/seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
