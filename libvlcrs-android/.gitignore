# Gradle / AGP outputs
.gradle/
build/
*/build/
local.properties
captures/
.kotlin/

# The cross compiled engine is produced by CI (or by cargo) and never committed
api/src/main/jniLibs/arm64-v8a/*.so

# The self-test media is generated by tools/make_test_media.sh in CI
demo/src/main/assets/*.mp4
demo/src/main/assets/*.mkv
demo/src/main/assets/*.webm

# keystores must never be committed
*.jks
*.keystore
